# Cache rules for Netlify and Cloudflare Pages (other hosts ignore this file).
# Files in /assets/ have a content hash in their name, so a changed file always gets a new
# URL: browsers and CDNs can keep them for a year without ever serving a stale version.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pages must be re-checked on every visit so a new deploy shows up straight away.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Icons and the social preview image change rarely but keep their names, so cache for a week.
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og-image.jpg
  Cache-Control: public, max-age=604800
